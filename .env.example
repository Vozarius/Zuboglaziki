# Скопируйте в .env и заполните локально. Файл .env исключён из Git.
SERVER_HOST=
SERVER_PORT=25565

# Пустой MAP_HOST означает SERVER_HOST. Укажите порт веб-карты.
MAP_HOST=
MAP_PORT=
MAP_SCHEME=http

# Секретный Discord webhook. Никогда не вставляйте его в HTML/JavaScript.
DISCORD_WEBHOOK_URL=

# Локальный порт сайта; хостинг обычно задаёт PORT сам.
PORT=3000
